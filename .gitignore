# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/.idea
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env.production
.env.development

# temporary voice-call TTS audio
/data/voice-audio/

# vercel
.vercel

# claude code local tooling
.claude/
.playwright-check/

# runtime user uploads (deposit receipts, ticket attachments, avatars,
# admin-uploaded news/blog images) — private user content, not source.
# Blog cover images referenced from src/data/blogPosts.ts are the
# exception: they're static seed assets meant to ship with the repo.
/public/uploads/*
!/public/uploads/blogs/
/public/uploads/blogs/*
!/public/uploads/blogs/blog-*.jpg
/public/images/uploads/

# typescript
*.tsbuildinfo
next-env.d.ts
