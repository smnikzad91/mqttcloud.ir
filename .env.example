# Mongo connection string — same database broker-service reads/writes.
MONGODB_URI=mongodb://user:pass@host:port/mqttcloudir?authSource=admin

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-value

# Must match broker-service's SOCKET_SHARED_SECRET — signs the short-lived
# token minted at /api/user/mqtt/socket-token for the live activity channel.
SOCKET_SHARED_SECRET=change-me-to-a-random-value-shared-with-broker-service
NEXT_PUBLIC_SOCKET_URL=http://localhost:4021

# Broker connection details shown to users on the MQTT dashboard page.
NEXT_PUBLIC_MQTT_HOST=mqtt.mqttcloud.ir
NEXT_PUBLIC_MQTT_PORT_TCP=1883
NEXT_PUBLIC_MQTT_PORT_TLS=8883
# For browser clients (mqtt.js) — the reverse proxy path in front of
# broker-service's MQTT_WS_PORT. Defaults to wss://<NEXT_PUBLIC_MQTT_HOST>/mqtt.
NEXT_PUBLIC_MQTT_WS_URL=wss://mqtt.mqttcloud.ir/mqtt

# Telegram channel notifications on blog/news/announcement publish.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=
TELEGRAM_PROXY=

# Outbound mail (src/lib/mailer.ts). Point at a local self-hosted relay
# (no auth needed) or a third-party SMTP provider (set SMTP_USER/SMTP_PASS too).
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=noreply@mqttcloud.ir

# nodepass.ir — card-to-card payment gateway (src/lib/nodepass.ts) used for
# wallet deposits (src/app/api/user/finance/deposits) and paid plan upgrades
# (src/app/api/user/plan/checkout). A merchant for mqttcloud.ir must be
# created first in nodepass.ir's own admin panel (پذیرندگان → add merchant →
# create API key → set webhook URL to https://mqttcloud.ir/api/nodepass/webhook
# → copy the webhook secret) — these values can't be generated from here.
NODEPASS_API_KEY=
NODEPASS_WEBHOOK_SECRET=
